
{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Room": {
      "title": "Study Room",
      "description": "A collaborative study workspace",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "inviteCode": { "type": "string" },
        "category": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "maxMembers": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "activeSessionId": { "type": "string" },
        "sharedNotes": { "type": "string" }
      },
      "required": ["title", "ownerId", "inviteCode"]
    },
    "Session": {
      "title": "Study Session",
      "description": "A focus work cycle",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "initiatorId": { "type": "string" },
        "goal": { "type": "string" },
        "startTime": { "type": "object", "description": "Firestore ServerTimestamp" },
        "durationMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "CANCELLED"] },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "participants": { 
          "type": "object", 
          "description": "Map of userId to joinTime" 
        },
        "isPomodoro": { "type": "boolean" },
        "pomodoroPhase": { "type": "string" },
        "completedIntervals": { "type": "number" }
      }
    },
    "Recap": {
      "title": "AI Session Recap",
      "description": "AI-generated summary of a study session",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "roomTitle": { "type": "string" },
        "summaryTitle": { "type": "string" },
        "overallSummary": { "type": "string" },
        "keyDiscussionPoints": { "type": "array", "items": { "type": "string" } },
        "generatedAt": { "type": "object", "description": "Firestore ServerTimestamp" },
        "viewerIds": { "type": "array", "items": { "type": "string" }, "description": "List of user UIDs who can view this recap" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "A chat message within a room",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string" }
      }
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Log of actions within a room",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Study room metadata"
    },
    "/rooms/{roomId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Focus sessions within a room"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Room chat history"
    },
    "/rooms/{roomId}/logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Room activity history"
    },
    "/rooms/{roomId}/recaps/{recapId}": {
      "schema": "Recap",
      "description": "AI generated summaries stored within rooms"
    }
  }
}
